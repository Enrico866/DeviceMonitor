{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DeviceMonitor.Agent.Sinks.LoggingSink": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",

  "Monitoring": {
    "PluginsPath": "plugins",
    "DataDirectory": "data",
    "Devices": [
      {
        "Id": "localhost",
        "Name": "This machine",
        "Host": "127.0.0.1",
        "IntervalSeconds": 15,
        "Probes": [
          { "Type": "icmp" },
          { "Type": "tcp", "Name": "agent_port", "Settings": { "port": "5080" } },
          { "Type": "http", "Name": "agent_health", "Settings": { "url": "http://localhost:5080/health" } }
        ],
        "Checks": [
          { "Metric": "icmp.reachable", "AlarmWhen": "Equal", "Threshold": 0, "FailuresBeforeAlarm": 2, "Severity": "Critical", "Description": "Host unreachable" },
          { "Metric": "agent_port.open", "AlarmWhen": "Equal", "Threshold": 0, "Severity": "Critical", "Description": "Agent TCP port closed" },
          { "Metric": "agent_health.response_ms", "AlarmWhen": "GreaterThan", "Threshold": 500, "FailuresBeforeAlarm": 3, "Description": "Health endpoint slow" }
        ]
      },
      {
        "Id": "public-dns",
        "Name": "Public DNS resolver",
        "Host": "1.1.1.1",
        "IntervalSeconds": 30,
        "Probes": [
          { "Type": "icmp", "Settings": { "count": "4", "timeoutMs": "800" } },
          { "Type": "tcp", "Name": "dns_tcp", "Settings": { "port": "53" } }
        ],
        "Checks": [
          { "Metric": "icmp.reachable", "AlarmWhen": "Equal", "Threshold": 0, "FailuresBeforeAlarm": 2, "Severity": "Critical", "Description": "Host unreachable" },
          { "Metric": "icmp.rtt_ms", "AlarmWhen": "GreaterThan", "Threshold": 100, "FailuresBeforeAlarm": 3, "Description": "High latency" },
          { "Metric": "icmp.packet_loss_percent", "AlarmWhen": "GreaterOrEqual", "Threshold": 50, "FailuresBeforeAlarm": 2, "Description": "Packet loss" }
        ]
      },
      {
        "Id": "lab-router-01",
        "Name": "SNMP router (run samples/SnmpSimulator)",
        "Host": "127.0.0.1",
        "IntervalSeconds": 10,
        "Probes": [
          {
            "Type": "snmp",
            "Settings": {
              "port": "16161",
              "collect": "system,cpu,memory,storage,interfaces",
              "interfaces": "GigabitEthernet0/0,GigabitEthernet0/1",
              "oid.temperature_c": "1.3.6.1.4.1.99999.1.1.0"
            }
          }
        ],
        "Checks": [
          { "Metric": "snmp.responding", "AlarmWhen": "Equal", "Threshold": 0, "FailuresBeforeAlarm": 2, "Severity": "Critical", "Description": "SNMP agent not responding" },
          { "Metric": "snmp.cpu_load_max_percent", "AlarmWhen": "GreaterThan", "Threshold": 80, "FailuresBeforeAlarm": 2, "Description": "CPU above 80%" },
          { "Metric": "snmp.memory_used_percent", "AlarmWhen": "GreaterThan", "Threshold": 90, "Description": "Memory above 90%" },
          { "Metric": "snmp.disk_max_used_percent", "AlarmWhen": "GreaterThan", "Threshold": 85, "Description": "Disk above 85%" },
          { "Metric": "snmp.if_down", "AlarmWhen": "GreaterThan", "Threshold": 0, "Severity": "Warning", "Description": "Interface admin up but link down" },
          { "Metric": "snmp.if_gigabitethernet0_0.in_mbps", "AlarmWhen": "GreaterThan", "Threshold": 900, "FailuresBeforeAlarm": 3, "Description": "Uplink saturated" },
          { "Metric": "snmp.temperature_c", "AlarmWhen": "GreaterThan", "Threshold": 70, "Severity": "Critical", "Description": "Temperature too high" }
        ]
      },
      {
        "Id": "lab-switch-01",
        "Name": "Simulated switch",
        "Host": "simulated.local",
        "IntervalSeconds": 5,
        "Probes": [
          { "Type": "simulated", "Settings": { "baseCpu": "35", "spikePercent": "20" } }
        ],
        "Checks": [
          { "Metric": "simulated.cpu_load_percent", "AlarmWhen": "GreaterThan", "Threshold": 80, "FailuresBeforeAlarm": 2, "Description": "CPU above 80%" },
          { "Metric": "simulated.temperature_c", "AlarmWhen": "GreaterThan", "Threshold": 72, "Severity": "Critical", "Description": "Temperature too high" }
        ]
      }
    ]
  }
}
